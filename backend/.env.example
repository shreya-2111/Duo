# Django Secret Key (generate a secure random 50+ character string)
SECRET_KEY=generate-a-secure-random-secret-key-for-production

# Debug Mode (Strictly False in Production)
DEBUG=False

# Allowed Hosts (comma-separated domain names or IP addresses)
ALLOWED_HOSTS=api.yourduoapp.com,your-duo-app.railway.app,localhost,127.0.0.1

# Option A: Full Database URL (e.g. Railway MySQL, PlanetScale, Aiven, AWS RDS)
# DATABASE_URL=mysql://user:password@host:port/database_name

# Option B: Discrete MySQL Connection Parameters
DB_ENGINE=mysql
DB_NAME=duo_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Allowed Origins (comma-separated Flutter web/mobile origins)
CORS_ALLOWED_ORIGINS=https://yourduoapp.com,http://localhost:3000

# Security Settings (uncomment for production HTTPS enforcement)
SECURE_SSL_REDIRECT=True
DJANGO_LOG_LEVEL=INFO
